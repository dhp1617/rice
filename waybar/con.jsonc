{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 8,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "group/hardware",
    "group/connectivity",
    "battery",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "on-click": "hyprlauncher",
    "tooltip-format": "Applications (hyprlauncher)"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○",
      "urgent": "󰀦"
    }
  },

  "clock": {
    "format": "󰥔  {:%a %d %b · %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "quickshell ipc call shell toggleCalendar"
  },

  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory"
    ]
  },

  "cpu": {
    "format": "  {usage}%",
    "tooltip": true,
    "on-click": "quickshell ipc call shell toggleThermal"
  },

  "memory": {
    "format": "  {used:0.1f}G",
    "tooltip": true,
    "on-click": "quickshell ipc call shell toggleMemory"
  },

  "group/connectivity": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "pulseaudio"
    ]
  },

  "network": {
    "format-wifi": "󰖩  {signalStrength}%",
    "format-ethernet": "󰈀  Online",
    "format-disconnected": "󰖪  Offline",
    "tooltip-format": "{essid} ({signalStrength}%)\nIP: {ipaddr}",
    "on-click": "quickshell ipc call shell toggleWifi"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰖁  Muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "tooltip-format": "{desc} // {volume}%",
    "on-click": "quickshell ipc call shell toggleAudio"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-full": "󰁹  {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}% ({timeTo})",
    "on-click": "quickshell ipc call shell toggleThermal"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Power Session Control",
    "on-click": "quickshell ipc call shell togglePower"
  }
}
